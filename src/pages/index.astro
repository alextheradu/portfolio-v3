---
import "../styles/global.css";
import ScrollReveal from "../components/ScrollReveal";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>alex radu</title>
    <meta
      name="description"
      content="alex radu — builds pipelines, robots, and the occasional tool that annoys dark patterns."
    />
    <script is:inline>
      document.documentElement.classList.add("gsap-loading");
      setTimeout(function () {
        document.documentElement.classList.remove("gsap-loading");
      }, 2000);
    </script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.min.js"></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
    ></script>
  </head>
  <body>
    <header>
      <a class="wordmark" href="#top">// portfolio :O</a>
      <nav>
        <a href="#about">about</a>
        <span class="sep">/</span>
        <a href="#expertise">skills</a>
        <span class="sep">/</span>
        <a href="#projects">projects</a>
        <span class="sep">/</span>
        <a href="https://github.com/alextheradu" target="_blank" rel="noopener"
          >github</a
        >
        <span class="sep">/</span>
        <a
          href="https://www.instagram.com/al3x_r4du/"
          target="_blank"
          rel="noopener">instagram</a
        >
        <span class="sep">/</span>
        <a
          href="https://www.linkedin.com/in/al3x-radu/"
          target="_blank"
          rel="noopener">linkedin</a
        >
      </nav>
    </header>

    <main>
      <section class="hero" id="top">
        <p class="eyebrow"></p>
        <h1>Alex Radu</h1>
        <p class="role">
          full stack web dev and hardware specialist 😎 (from nj!)
        </p>
        <p>
          i build cool apps (i think) like curator, my frc team's scouting app,
          and more!
        </p>
      </section>

      <section id="about">
        <h2>about</h2>
        <p>
          i'm a junior at Pascack Hills High School and I lead infotech
          (websites, scouting, etc) for FRC Team 1676 the Pascack Pi-oneers!
          this past summer i interned in the shah lab at Memorial Sloan
          Kettering, working on <a href="#datac">genomics pipelines</a>. outside
          of that I founded and run my school's Hack Club chapter (<a
            href="https://phhshack.club"
            target="_blank"
            rel="noopener">here's our website</a
          >!), also run YSWS programs (join <a
            href="https://tagless.hackclub.com"
            target="_blank"
            rel="noopener">tagless</a
          >!), and I spend some of my downtime in Fusion 360 and Bambu Studio
          designing things and then 3D printing them. i also listen to a lot of
          music and do photography mostly with my drone (dji m5p) and my iphone!
        </p>
      </section>

      <section id="expertise">
        <h2>areas of expertise</h2>
        <div class="expertise-list">
          <div class="expertise-row">
            <span class="num">01</span>
            <h3>web development</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="full-stack with React, Next.js, Node.js, PostgreSQL, and some python."
            />
          </div>
          <div class="expertise-row">
            <span class="num">02</span>
            <h3>robotics &amp; frc</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="scouting apps and internal tools for FIRST robotics teams. "
            />
          </div>
          <div class="expertise-row">
            <span class="num">03</span>
            <h3>3D modeling</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="custom parts in Fusion 360, printed through Bambu Studio (btw i have a p2s)"
            />
          </div>
          <div class="expertise-row">
            <span class="num">04</span>
            <h3>infrastructure</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="nginx proxies, PM2 deployments, docker containers, and system management."
            />
          </div>
        </div>
      </section>

      <section id="projects">
        <h2>things i've built</h2>

        <div class="project-list">
          <div class="project-row">
            <div class="project-head">
              <span class="index">01</span>
              <h3>
                <a href="https://curatorfrc.com" target="_blank" rel="noopener"
                  >Curator</a
                >
              </h3>
              <div class="tags">
                <span>frc</span><span>ai</span><span>next js</span>
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="an AI chatbot and assistant for FIRST Robotics teams, built to help teams get quick, reliable answers during build season without stifling innovation. this tool is specifically designed to work alongside students, not do the work for them."
            />
          </div>

          <div class="project-row">
            <div class="project-head">
              <span class="index">02</span>
              <h3>
                <a
                  href="https://tagless.hackclub.com"
                  target="_blank"
                  rel="noopener">tagless</a
                >
              </h3>
              <div class="tags">
                <span>hack club</span><span>javascript</span><span>html</span>
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="a Hack Club YSWS i run: build a website without using a single HTML tag, ship it, and we mail you a luggage tag as a prize."
            />
          </div>

          <div class="project-row" id="datac">
            <div class="project-head">
              <span class="index">03</span>
              <h3>
                <a
                  href="https://github.com/alextheradu/shahlab-nf-scatac/"
                  target="_blank"
                  rel="noopener">DATAC pipeline</a
                >
              </h3>
              <div class="tags">
                <span>nextflow</span><span>nf-core</span><span
                  >bioinformatics</span
                >
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="a nextflow pipeline for demultiplexing ATAC and WGS reads from the DATAC single-cell co-assay. built during my summer internship in the Shah lab at Memorial Sloan Kettering (mskcc)."
            />
          </div>

          <div class="project-row">
            <div class="project-head">
              <span class="index">04</span>
              <h3>
                <a
                  href="https://github.com/PioneersTeam1676/1676-maneuver"
                  target="_blank"
                  rel="noopener">Pioneer Scouting</a
                >
              </h3>
              <div class="tags">
                <span>react</span><span>express</span><span>sqlite</span><span
                  >dexie</span
                >
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="full rebuild of the scouting web app for the Pascack Pioneers (frc 1676). React and Express under the hood, with offline storage so it still works in a scouting stand with no signal, and a Google OAuth role system for pit scouts, drive teams, and leads."
            />
          </div>

          <div class="project-row">
            <div class="project-head">
              <span class="index">05</span>
              <h3>
                <a
                  href="https://github.com/eesazahed/mappetite-ai"
                  target="_blank"
                  rel="noopener">Mappetite</a
                >
              </h3>
              <div class="tags">
                <span>react</span><span>express</span><span>sqlite</span><span
                  >dexie</span
                >
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="ai travel meal planning app built at HackMIT Blueprint 2026!"
            />
          </div>

          <div class="project-row">
            <div class="project-head">
              <span class="index">06</span>
              <h3>Self-hosted infrastructure</h3>
              <div class="tags">
                <span>docker</span><span>nginx</span><span>linux</span>
              </div>
            </div>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="a docker and nginx proxy manager setup that hosts my robotics team's scouting app and a handful of side projects across a few domains, all on hardware and networks i manage myself."
            />
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>
        reach me on <a
          href="https://github.com/alextheradu"
          target="_blank"
          rel="noopener">github</a
        >, check out my photos and videos on <a
          href="https://www.instagram.com/al3x_r4du/"
          target="_blank"
          rel="noopener">instagram</a
        >, and see me larp on <a
          href="https://www.linkedin.com/in/al3x-radu/"
          target="_blank"
          rel="noopener">linkedin</a
        >.
      </p>
    </footer>

    <script is:inline src="/main.js"></script>
  </body>
</html>
