---
import "../styles/global.css";
import ScrollReveal from "../components/ScrollReveal";
import SectionNav from "../components/SectionNav";
import * as si from "simple-icons";
import rawGoals from "../data/goals.json";
import projects from "../data/projects.json";
import profile from "../data/profile.json";

// resolves "current" for any goal backed by a live source (fetched at
// build time, so it updates whenever the site is rebuilt/deployed —
// no client-side fetch, no CORS/runtime-failure risk for visitors).
// falls back to the goal's `fallback` value if the source is down.
async function resolveCurrent(goal: (typeof rawGoals)[number]) {
  if (goal.source === "quizzr-users") {
    try {
      const res = await fetch("https://quizzr.org/api/users/count");
      const count = Number(await res.text());
      if (Number.isFinite(count)) return count;
    } catch {
      // fall through to fallback below
    }
    return goal.fallback ?? 0;
  }
  return goal.current ?? 0;
}

const goals = await Promise.all(
  rawGoals.map(async (goal) => {
    const current = await resolveCurrent(goal);
    const percent = Math.min(100, Math.round((current / goal.target) * 100));
    return {
      label: goal.label,
      current,
      suffix: `/${goal.target}${goal.unit ? " " + goal.unit : ""}`,
      percent,
    };
  })
);

const icon = (slug: string | null) => {
  if (!slug) return "";
  const i = (si as any)["si" + slug[0].toUpperCase() + slug.slice(1)];
  return i ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${i.path}"/></svg>` : "";
};

const goalsYear = new Date().getFullYear();

const sections = [
  { id: "about", label: "about" },
  { id: "hackclub", label: "hack club" },
  { id: "expertise", label: "skills" },
  { id: "projects", label: "projects" },
  { id: "gear", label: "gear" },
  { id: "life", label: "photos" },
  { id: "goals", label: "goals" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>alex radu</title>
    <meta
      name="description"
      content="alex radu — builds pipelines, robots, and the occasional tool that annoys dark patterns."
    />
    <script is:inline>
      document.documentElement.classList.add("gsap-loading");
      setTimeout(function () {
        document.documentElement.classList.remove("gsap-loading");
      }, 2000);
    </script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.min.js"></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
    ></script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>

    <header>
      <a class="wordmark" href="#top">// portfolio :O</a>
      <nav class="social">
        <a href="https://github.com/alextheradu" target="_blank" rel="noopener"
          >github</a
        >
        <span class="sep">/</span>
        <a
          href="https://www.instagram.com/al3x_r4du/"
          target="_blank"
          rel="noopener">instagram</a
        >
        <span class="sep">/</span>
        <a
          href="https://www.linkedin.com/in/al3x-radu/"
          target="_blank"
          rel="noopener">linkedin</a
        >
      </nav>
    </header>

    <!-- left rail: ReactBits line-sidebar section nav (wide screens only) -->
    <aside class="rail">
      <SectionNav client:load sections={sections} />
    </aside>

    <main>
      <section class="hero" id="top">
        <p class="eyebrow"></p>
        <h1>Alex Radu</h1>
        <p class="role">
          full stack web dev and hardware specialist 😎 (from nj!)
        </p>
        <p>
          i build pipelines, robots, and scouting apps, like curator, my frc team's scouting app, and more! i also run
          ysws programs at hack club, where teens ship real projects and get
          prizes in the mail.
        </p>
      </section>

      <section id="about">
        <h2>about</h2>
        <p>
          junior at pascack hills high school, from nj. i lead infotech for frc
          team 1676, interned in the shah lab at memorial sloan kettering on <a href="#datac-row">genomics pipelines</a>, and run hack club things on the side (<a
            href="https://phhshack.club"
            target="_blank"
            rel="noopener">phhshack.club</a
          >, <a
            href="https://contd.hackclub.com"
            target="_blank"
            rel="noopener">cont.d</a
          >). off the clock: fusion 360, 3d printing, music, and drone photos.
        </p>

        <ol class="timeline">
          <li>
            <span class="when">now</span>
            <span class="body">
              {profile.currently.map((c) => <span class="what">{c}</span>)}
            </span>
          </li>
          {
            profile.timeline.map((t) => (
              <li>
                <span class="when">{t.when}</span>
                <span class="body">
                  <span class="what">{t.what}</span>
                  <span class="note">{t.note}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="hackclub">
        <h2>hack club</h2>
        <p class="lead">
          i founded my school's chapter and i run ysws ("you ship, we ship")
          programs where teens build and ship real projects, then get something
          in the mail.
        </p>
        <div class="hc-list">
          {
            profile.hackclub.map((h) => (
              <a class="hc-row" href={h.href} target="_blank" rel="noopener">
                <span class="hc-role">{h.role}</span>
                <span class="hc-name">{h.name}</span>
                <span class="hc-text">{h.text}</span>
                <span class="hc-link">{h.label}<i class="arrow-ne" aria-hidden="true"></i></span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="expertise">
        <h2>areas of expertise</h2>
        <div class="expertise-list">
          <div class="expertise-row">
            <span class="num">01</span>
            <h3>web development</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="full-stack with React, Next.js, Node.js, PostgreSQL, and some python."
            />
          </div>
          <div class="expertise-row">
            <span class="num">02</span>
            <h3>robotics &amp; frc</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="scouting apps and internal tools for FIRST robotics teams. "
            />
          </div>
          <div class="expertise-row">
            <span class="num">03</span>
            <h3>3D modeling</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="custom parts in Fusion 360, printed through Bambu Studio (btw i have a p2s)"
            />
          </div>
          <div class="expertise-row">
            <span class="num">04</span>
            <h3>infrastructure</h3>
            <ScrollReveal
              client:visible={{ rootMargin: "600px 0px" }}
              baseOpacity={0.15}
              text="a home server running dokploy and traefik, docker containers, nginx proxies, PM2, and general system management."
            />
          </div>
        </div>
      </section>

      <section id="projects">
        <h2>things i've built <span class="hint">click one</span></h2>

        <div class="project-list">
          {
            projects.map((p, i) => (
              <div
                class="project-row"
                id={p.id === "datac" ? "datac-row" : undefined}
                data-project={p.id}
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
              >
                <div class="project-head">
                  <span class="index">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{p.title}</h3>
                  <span class="open-hint" aria-hidden="true"><i class="arrow-ne"></i></span>
                  <div class="tags">
                    {p.tags.map((t) => (
                      <span>{t}</span>
                    ))}
                  </div>
                </div>
                <ScrollReveal
                  client:visible={{ rootMargin: "600px 0px" }}
                  baseOpacity={0.15}
                  text={p.summary}
                />
              </div>
            ))
          }
        </div>
      </section>

      <section id="gear">
        <h2>tools &amp; gear</h2>
        <div class="gear-list">
          {
            profile.gear.map((g) => (
              <div class="gear-row">
                <span class="gear-name">{g.name}</span>
                <ul class="gear-items">
                  {g.items.map(([label, slug, href]) => (
                    <li>
                      <a href={href} target="_blank" rel="noopener">
                        <Fragment set:html={icon(slug)} />
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="homeserver">{profile.homeserver}</p>
      </section>

      <section id="life">
        <h2>photos</h2>
        <div class="life-grid">
          {
            profile.life.map((l, i) => (
              <figure class="life-tile" style={{ "--i": i }}>
                <img src={l.src} alt={l.caption} loading="lazy" />
                <figcaption>{l.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section id="goals">
        <div class="section-head">
          <h2>personal goals</h2>
          <span class="year">{goalsYear}</span>
        </div>
        <div class="goal-list">
          {
            goals.map((goal) => (
              <div class="goal-row">
                <div class="goal-head">
                  <h3>{goal.label}</h3>
                  <span class="count">
                    <span class="count-num" data-to={goal.current}>
                      {goal.current}
                    </span>
                    {goal.suffix}
                  </span>
                </div>
                <div class="goal-bar">
                  <div
                    class="goal-bar-fill"
                    data-percent={goal.percent}
                    style={{ width: `${goal.percent}%` }}
                  />
                </div>
                <p class="goal-caption">{goal.percent}% complete</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <p>
        reach me on <a
          href="https://github.com/alextheradu"
          target="_blank"
          rel="noopener">github</a
        >, check out my photos and videos on <a
          href="https://www.instagram.com/al3x_r4du/"
          target="_blank"
          rel="noopener">instagram</a
        >, see me larp on <a
          href="https://www.linkedin.com/in/al3x-radu/"
          target="_blank"
          rel="noopener">linkedin</a
        >, or email me at <a href="mailto:alex@alexradu.co"
          >alex@alexradu.co</a
        >.
      </p>
    </footer>

    <dialog id="project-dialog" aria-labelledby="pd-title">
      <div class="pd-body"></div>
    </dialog>
    <script
      is:inline
      type="application/json"
      id="projects-data"
      set:html={JSON.stringify(projects)}
    />

    <script is:inline src="/main.js"></script>
    <script is:inline src="/extras.js"></script>
  </body>
</html>
